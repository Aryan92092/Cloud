# ============================================================
# Backend Environment Variables
# Copy this file to backend/.env and fill in your real values.
# NEVER commit the .env file to GitHub.
# ============================================================

# Server port (default: 5000)
PORT=5000

# Node environment: development | production
NODE_ENV=production

# Optional: MongoDB connection string.
# If not provided, the app uses a fast in-memory data store automatically.
# Example with MongoDB Atlas:
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/student_ranking_daa
# Example with local MongoDB:
#   MONGODB_URI=mongodb://localhost:27017/student_ranking_daa
# Leave blank to use the built-in in-memory store (recommended for testing).
MONGODB_URI=
